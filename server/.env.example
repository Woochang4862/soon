# server/.env 로 복사해 값을 채운다. .env 는 커밋되지 않는다.

# MySQL (docker-compose 의 mysql 서비스)
DB_HOST=mysql
DB_USER=root
DB_PASSWORD=
DB_NAME=alarm_db
COMPANY_ALARM_TABLE_NAME=company_alarm

# TMDB API v3 키
TMDB_API_KEY=

# Firebase 서비스 계정 키 경로. docker-compose 가 컨테이너 안 경로로 덮어쓴다.
# 로컬에서 node 로 직접 띄울 때만 이 값을 쓴다.
GOOGLE_APPLICATION_CREDENTIALS=./secrets/firebase-sa.json
# 선택. 기본값 https://soon-79c2e.firebaseio.com
# FIREBASE_DATABASE_URL=
